<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/accesoBlanco"
    android:orientation="vertical"
    tools:context=".Vista.RecuperarActivity">

    <!-- Barra superior azul VITAN: titulo y logo chico -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tbBarra"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/accesoAzul"
        app:contentInsetStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnRegresar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/txtRegresar"
                android:src="@drawable/ic_regresar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/txtTituloRecuperar"
                android:textColor="@color/accesoBlanco"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/txtLogo"
                android:src="@drawable/logo_vitan" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ScrollView para que el teclado no tape los campos -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Pasos: 1 Tu correo / 2 Pregunta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPaso1"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_acceso_paso_activo"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="@string/txtPaso1"
                android:textColor="@color/accesoAzul"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPaso2"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_acceso_paso_inactivo"
                android:gravity="center"
                android:text="@string/txtPaso2"
                android:textColor="@color/accesoGris"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Paso 1: se oculta cuando la API encuentra el correo -->
        <LinearLayout
            android:id="@+id/llPaso1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_acceso_circulo">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_recuperar" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/txtOlvidasteTitulo"
            android:textColor="@color/accesoAzul"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/txtInstrucciones"
            android:textColor="@color/accesoGris"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/lblCorreo"
            android:textColor="@color/accesoAzul"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCorreo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/acceso_borde_campo"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_correo"
            app:startIconTint="@color/accesoAzul">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/phCorreo"
                android:inputType="textEmailAddress"
                android:textColor="@color/accesoAzul"
                android:textColorHint="@color/accesoAzul"
                android:textSize="15sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Aviso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_acceso_aviso"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/txtAvisoRecuperar"
                android:textColor="@color/accesoAzul"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/btnBuscar"
            android:textColor="@color/accesoBlanco"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accesoBoton"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_flecha_derecha"
            app:iconGravity="textStart"
            app:iconTint="@color/accesoBlanco" />

        <TextView
            android:id="@+id/txtIniciarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:padding="4dp"
            android:text="@string/txtYaRecordaste"
            android:textColor="@color/accesoBoton"
            android:textSize="14sp"
            android:textStyle="bold" />
        </LinearLayout>

        <!-- Paso 2: oculto hasta que la API encuentra el correo -->
        <LinearLayout
            android:id="@+id/llPaso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <TextView
            android:id="@+id/txtCorreoElegido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/ic_correo"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="@color/accesoAzul"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="cliente@vitan.mx" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblTuPregunta"
            android:textColor="@color/accesoAzul"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_acceso_aviso"
            android:padding="14dp"
            android:textColor="@color/accesoAzul"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="¿Cuál es el nombre de tu primera mascota?" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblRespuesta"
            android:textColor="@color/accesoAzul"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRespuesta"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/acceso_borde_campo"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_llave"
            app:startIconTint="@color/accesoAzul"
            app:helperText="@string/txtAyudaMayusculas"
            app:helperTextTextColor="@color/accesoGris">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRespuesta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/phRespuesta"
                android:inputType="text"
                android:textColor="@color/accesoAzul"
                android:textColorHint="@color/accesoAzul"
                android:textSize="15sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblNueva"
            android:textColor="@color/accesoAzul"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNueva"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/acceso_borde_campo"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_candado"
            app:startIconTint="@color/accesoAzul"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/accesoAzul">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/phContrasena"
                android:inputType="textPassword"
                android:textColor="@color/accesoAzul"
                android:textColorHint="@color/accesoAzul"
                android:textSize="15sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblConfirmar"
            android:textColor="@color/accesoAzul"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmar"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/acceso_borde_campo"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_candado"
            app:startIconTint="@color/accesoAzul"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/accesoAzul"
            app:helperText="@string/txtAyudaMinimo"
            app:helperTextTextColor="@color/accesoGris">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/phContrasena"
                android:inputType="textPassword"
                android:textColor="@color/accesoAzul"
                android:textColorHint="@color/accesoAzul"
                android:textSize="15sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/btnCambiarContrasena"
            android:textColor="@color/accesoBlanco"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accesoBoton"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_check_circulo"
            app:iconGravity="textStart"
            app:iconTint="@color/accesoBlanco" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/accesoBoton"
            android:visibility="gone" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
